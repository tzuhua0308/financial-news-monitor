# ─── 複製此檔為 .env，填入你的 API Keys ───────────────────────────────────
# cp .env.example .env
# 注意：.env 已加入 .gitignore，不要 commit 真實 Key！

# NewsAPI（免費申請）https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# Reddit API（申請教學：https://www.reddit.com/prefs/apps）
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_SECRET=your_reddit_client_secret

# LINE Notify（台灣常用）https://notify-bot.line.me/zh_TW/
LINE_NOTIFY_TOKEN=your_line_notify_token

# Telegram Bot（BotFather 建立）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
